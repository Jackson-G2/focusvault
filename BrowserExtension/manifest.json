{
  "manifest_version": 3,
  "name": "Vaulty — Short-form & Channel Vault",
  "version": "0.13.0",
  "description": "Block short-form content and enforce Vaulty’s password-plus-challenge YouTube sessions.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.tiktok.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://fb.watch/*",
    "*://*.fb.watch/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vaulty short-form vault",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://fb.watch/*",
        "*://*.fb.watch/*"
      ],
      "js": [
        "policy.js",
        "session-policy.js",
        "content.js"
      ],
      "css": [
        "guard.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "blocked.js"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://fb.watch/*",
        "*://*.fb.watch/*"
      ]
    }
  ]
}
